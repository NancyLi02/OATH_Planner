# Message type for task assignments to robots
# Each field represents the list of tasks assigned to a specific robot.

int32 robot_1_task  # Tasks assigned to Robot 1
int32 robot_2_task  # Tasks assigned to Robot 2
int32 robot_3_task  # Tasks assigned to Robot 3

# The robot's position in (x, y) format
int32 robot_1_pos
int32 robot_2_pos
int32 robot_3_pos